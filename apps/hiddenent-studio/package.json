{
  "name": "hiddenent-video-photo-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Hiddenent Video & Photo Studio — 브라우저 기반 동영상·사진 통합 촬영 웹앱",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "preview:https": "vite preview --mode https",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "build:single": "tsc --noEmit -p . && vite build --mode single && node -e \"require('fs').renameSync('standalone/index.html','standalone/hiddenent-studio.html')\""
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "fix-webm-duration": "^1.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright-core": "^1.56.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.4"
  }
}
